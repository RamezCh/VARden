{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VARden",
  "version": "0.1.1",
  "identifier": "io.github.ramezch.varden",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VARden",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ramez Chreide",
    "copyright": "© 2026 Ramez Chreide",
    "homepage": "https://github.com/RamezCh/VARden",
    "category": "DeveloperTool",
    "shortDescription": "Manage your environment variables safely",
    "longDescription": "VARden shows all your user environment variables in one place, flags broken ones, edits PATH safely, keeps backups of every change and updates open terminals without restarting them.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "VARden"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQUJFMTE5MzA3N0FDNkQKUldSdHJIY3dHZUdyTE9ETmxVMWF3ZDkrRnI1RC9idWhTMzVYbWdWK25DYWNoL3JCWUZDd3pnT0kK",
      "endpoints": [
        "https://github.com/RamezCh/VARden/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
